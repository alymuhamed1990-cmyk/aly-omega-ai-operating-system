{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"aly-omega/acp/4.0",
  "title":"Agent Communication Protocol",
  "type":"object",
  "required":["task","context","evidence","findings","assumptions","risks","confidence","recommendation","dependencies","validation_status"],
  "properties":{
    "task":{"type":"string"},
    "context":{"type":"object"},
    "evidence":{"type":"array","items":{"type":"object"}},
    "findings":{"type":"array","items":{"type":"string"}},
    "assumptions":{"type":"array","items":{"type":"string"}},
    "risks":{"type":"array","items":{"type":"string"}},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "recommendation":{"type":"string"},
    "dependencies":{"type":"array","items":{"type":"string"}},
    "validation_status":{"enum":["PENDING","PASSED","FAILED","BLOCKED","NOT_REQUIRED"]},
    "claim_states":{"type":"array","items":{"enum":["CONFIRMED","STRONG_EVIDENCE","PROBABLE","UNVERIFIED","CONTRADICTED","OUTDATED","HYPOTHESIS"]}},
    "trace_id":{"type":"string"},
    "intake_lock":{"type":"boolean"},
    "source_quality":{"type":"string"},
    "contradictions":{"type":"array","items":{"type":"object"}},
    "validation_notes":{"type":"array","items":{"type":"string"}}
  },
  "additionalProperties":true
}